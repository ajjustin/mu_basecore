[Defines]
  FILE_GUID = 7f3d7c8c-3b7c-4f4a-9c3f-9b1f5a9f3f5e
  MODULE_TYPE = HOST_APPLICATION
  VERSION_STRING = 1.0
  ENTRY_POINT = LogPerformanceMeasurement

[Sources]
  PerformanceLib.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  DebugLib
